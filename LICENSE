name: Build SHAID PRO APK

on:
workflow_dispatch:
push:
branches: [main]

jobs:
build:
runs-on: ubuntu-latest
steps:
- uses: actions/checkout@v4

  - name: Extract project
    run: unzip -q SHAID_PRO_Android_Project.zip -d source

  - uses: actions/setup-java@v4
    with:
      distribution: temurin
      java-version: '17'

  - uses: android-actions/setup-android@v3

  - name: Install Android SDK
    run: sdkmanager "platforms;android-35" "build-tools;35.0.0"

  - uses: gradle/actions/setup-gradle@v4
    with:
      gradle-version: '8.9'

  - name: Build APK
    working-directory: source/SHAID_PRO_Android_Project
    run: gradle --no-daemon assembleDebug

  - uses: actions/upload-artifact@v4
    with:
      name: SHAID-PRO-debug-APK
      path: source/SHAID_PRO_Android_Project/app/build/outputs/apk/debug/app-debug.apk
